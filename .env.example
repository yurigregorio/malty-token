# Browser-exposed Solana Mainnet RPC endpoint.
# IMPORTANT: variables prefixed with NEXT_PUBLIC_ are bundled into the browser.
# Never place a secret/unrestricted provider API key here.
# Use a public endpoint or a provider credential restricted by origin/domain,
# rate limits and the minimum permissions needed for read-only Mainnet access.
NEXT_PUBLIC_SOLANA_MAINNET_RPC_URL=https://your-public-or-restricted-mainnet-rpc.example.com

# Optional browser-exposed WebSocket endpoint. If omitted, the app derives
# ws:// or wss:// from the RPC URL above.
# NEXT_PUBLIC_SOLANA_MAINNET_WS_URL=wss://your-public-or-restricted-mainnet-rpc.example.com
