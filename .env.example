# Dedicated Solana Mainnet RPC endpoint.
# Do not commit your real provider URL/API key; copy this file to .env.local.
NEXT_PUBLIC_SOLANA_MAINNET_RPC_URL=https://your-mainnet-rpc.example.com

# Optional. If omitted, the app derives ws:// or wss:// from the RPC URL above.
# NEXT_PUBLIC_SOLANA_MAINNET_WS_URL=wss://your-mainnet-rpc.example.com
